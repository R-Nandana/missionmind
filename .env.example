# MongoDB Atlas
MONGODB_URI=mongodb://localhost:27017/missionmind

# JWT
JWT_SECRET=replace_with_a_random_64_character_secret

# Admin login (required only when using the Admin tab)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_long_unique_admin_password

# Analysis service & AI Insights
ANALYSIS_SERVICE_URL=http://localhost:8000
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Backend
BACKEND_PORT=3001

# Frontend
VITE_API_URL=http://localhost:3001/api
